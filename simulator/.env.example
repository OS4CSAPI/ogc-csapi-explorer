# ── OS4CSAPI Data Simulator — Environment Variables ──────────────────────
#
# Copy this file to `.env` and fill in the values for your SensorHub instance.
# The simulator will fail-fast on startup if any of these are missing.
#
# OSH_ADDRESS  — hostname (or host:port) of your SensorHub server
#                (do NOT include the scheme or /sensorhub/api path)
# OSH_USER     — SensorHub API username
# OSH_PASS     — SensorHub API password

OSH_ADDRESS=my-osh-server.example.com
OSH_USER=admin
OSH_PASS=changeme
